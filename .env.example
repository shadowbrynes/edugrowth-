# VITE_GEMINI_API_KEY: Required for Gemini AI API calls on the client side.
# Copy this file to .env.local and fill in your Gemini API key from Google AI Studio.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: Server-side environment key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
